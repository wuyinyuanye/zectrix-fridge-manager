// Optional private defaults for your own builds (so a freshly flashed device joins
// your Wi-Fi without opening the setup page). Copy this file to main/local_secrets.h,
// fill in your values and rebuild. main/local_secrets.h is git-ignored.
#pragma once
#define FRIDGE_DEFAULT_WIFI_SSID "YourWiFiName"
#define FRIDGE_DEFAULT_WIFI_PASS "YourWiFiPassword"
// Public Xiaozhi cloud (default) or your own LAN server, e.g. "http://192.168.1.100:8003/xiaozhi/ota/"
#define FRIDGE_DEFAULT_OTA_URL "https://api.tenclass.net/xiaozhi/ota/"
